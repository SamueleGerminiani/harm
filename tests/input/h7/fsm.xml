<harm>
    <!-- H7 (acceptance A1-A3, A5): COI filter mode on the H4 fixture "fsm". Every proposition
         can be antecedent, consequent or decision-tree candidate; one consequent placeholder per
         template (needed by the per-consequent oracle, H7_PLAN F3). -->
    <context name="default">
        <prop exp="rst" loc="a, c, dt"/>
        <prop exp="go" loc="a, c, dt"/>
        <prop exp="stop" loc="a, c, dt"/>
        <prop exp="busy" loc="a, c, dt"/>
        <prop exp="finished" loc="a, c, dt"/>
        <prop exp="state == 2&apos;d0" loc="a, c, dt"/>
        <prop exp="state == 2&apos;d1" loc="a, c, dt"/>
        <coi file="../coi/fsm/expected_coi.json" mode="filter"/>
        <template exp="G(P0 -&gt; P1)"/>
        <template exp="G(P0 -&gt; X P1)"/>
        <template exp="G(P0 &amp;&amp; P1 -&gt; X P2)"/>
        <template dtLimits="3A" exp="G({..&amp;&amp;..}|-&gt; X P0)"/>
        <template dtLimits="3A" exp="G({..#1&amp;..}|-&gt; P0)"/>
        <sort name="frequency" exp="atct/traceLength"/>
    </context>
</harm>
