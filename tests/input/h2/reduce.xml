<harm>
    <!-- H2, acceptance test A5 (trace: tests/input/h1/newops.csv). Hand-derived:
           A1  cnt == 4'd6        t1           A1' 4'd6 == cnt  (equivalent to A1: merged)
           A2  {go, s} == 3'b110  t1 t2 t5
           C1  s !== 2'b00        t1 t2 t3 t5  C2  s != 2'b00  (same rows on this x-free trace,
                                                                but not equivalent: kept apart)
         All six implications {A1, A1', A2} -> {C1, C2} hold. With reduce=equiv, A1 and A1' are
         merged and the smallest text is kept: 4 assertions instead of 6. -->
    <context name="default">
        <prop exp="cnt == 4'd6" loc="a"/>
        <prop exp="4'd6 == cnt" loc="a"/>
        <prop exp="{go, s} == 3'b110" loc="a"/>
        <prop exp="s !== 2'b00" loc="c"/>
        <prop exp="s != 2'b00" loc="c"/>
        <template exp="G(P0 -> P1)"/>
        <sort name="frequency" exp="atct/traceLength"/>
    </context>
</harm>
